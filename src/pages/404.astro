---
import { Button } from 'astro-pure/user'

import { localizedPath } from '@/i18n/config'
import { ui } from '@/i18n/ui'
import PageLayout from '@/layouts/BaseLayout.astro'

// GitHub Pages serves a single 404 page for every URL, so it is shown in both languages.
---

<PageLayout locale='en' alternates={{}} meta={{ title: '404' }}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-lg'>{ui.en.notFound}</p>
    <p class='text-muted-foreground'>{ui.en.notFoundText}</p>
    <p class='mt-6 text-lg' lang='vi'>{ui.vi.notFound}</p>
    <p class='text-muted-foreground' lang='vi'>{ui.vi.notFoundText}</p>
    <div class='mt-8 flex flex-wrap justify-center gap-3'>
      <Button title={ui.en.backToHome} href={localizedPath('en', '/')} variant='ahead' />
      <Button title={ui.vi.backToHome} href={localizedPath('vi', '/')} variant='ahead' />
    </div>
  </div>
</PageLayout>
