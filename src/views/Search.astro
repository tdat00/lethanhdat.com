---
import { Button } from 'astro-pure/user'

import { localizedPath, type Locale } from '@/i18n/config'
import { useTranslations } from '@/i18n/ui'
import PFSearch from '@/components/PFSearch.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<PageLayout {locale} meta={{ title: t.searchTitle, description: t.searchDescription }}>
  <Button title={t.back} href={localizedPath(locale, '/blog')} variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{t.searchTitle}</h1>
    </div>

    <div id='content' class='animate'>
      {
        integ.pagefind && (
          <>
            <p>{t.searchPrompt}</p>
            <PFSearch {locale} />
          </>
        )
      }
    </div>
  </main>
</PageLayout>
