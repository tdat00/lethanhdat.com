---
import { Icon } from 'astro-pure/user'
import config from 'virtual:config'

import { localizedPath, type Locale } from '@/i18n/config'
import { useTranslations } from '@/i18n/ui'
import { profile } from '@/site-config'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const social = [
  { icon: 'github', label: t.github, href: profile.github },
  { icon: 'email', label: t.email, href: `mailto:${profile.email}` },
  { icon: 'rss', label: 'RSS', href: localizedPath(locale, '/rss.xml') }
] as const
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='flex items-center gap-x-4 gap-y-2 text-muted-foreground max-sm:flex-col'>
        <div>{config.footer.year} {config.author}</div>
        <span>
          {t.footerCredits}
          <a href='https://astro.build' target='_blank' rel='noopener'>Astro</a>
          &
          <a href='https://github.com/cworld1/astro-theme-pure' target='_blank' rel='noopener'>
            Pure
          </a>
          {t.footerTheme}
        </span>
      </div>

      <div class='flex items-center gap-x-4'>
        {
          social.map(({ label, href, icon }) => (
            <a {href} rel='me' class='sl-flex'>
              <span class='sr-only'>{label}</span>
              <Icon name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: underline;
    font-weight: 500;
  }
</style>
