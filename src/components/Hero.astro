---
import { Icon } from 'astro-pure/user'

import type { Locale } from '@/i18n/config'
import { useTranslations } from '@/i18n/ui'
import { formatDate, readingMinutes, tagUrl, type Post } from '@/utils/content'

interface Props {
  post: Post
  locale: Locale
  words: unknown
}

const { post, locale, words } = Astro.props
const { title, description, draft, publishDate, updatedDate, tags } = post.data
const t = useTranslations(locale)
---

{draft ? <span class='text-red-500'>(Draft)</span> : null}

<div class='article-info max-lg:mx-auto'>
  <div class='flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
    <div class='flex items-center gap-1'>
      <Icon name='calendar' class='size-5' />
      <time class='font-mono' datetime={publishDate.toISOString()}>
        {formatDate(publishDate, locale)}
      </time>
      {
        updatedDate && (
          <span class='flex items-center gap-1'>
            <span> / </span>
            <span>
              {t.updated}
              <time class='font-mono' datetime={updatedDate.toISOString()}>
                {formatDate(updatedDate, locale)}
              </time>
            </span>
          </span>
        )
      }
    </div>
    <div class='flex items-center gap-1'>
      <Icon name='time' class='size-5' />
      {t.readingTime(readingMinutes(words))}
    </div>
    {
      !!tags.length && (
        <span class='flex items-center gap-1'>
          <Icon name='hashtag' class='size-5' />
          {tags.map((tag, i) => (
            <div>
              <a
                aria-label={t.viewTag(tag)}
                class='hover:underline hover:underline-offset-4'
                data-pagefind-filter='tag'
                href={tagUrl(locale, tag)}
              >
                {tag}
              </a>
              {i < tags.length - 1 && '/'}
            </div>
          ))}
        </span>
      )
    }
  </div>

  <h1 class='mt-4 text-2xl font-medium sm:mb-2 sm:mt-6 sm:text-3xl'>{title}</h1>

  <div class='mt-3 italic'>
    <blockquote class='text-sm text-muted-foreground'><q>{description}</q></blockquote>
  </div>
</div>

{/* Dividing line */}
<div class='mt-4 w-1/2 border-t max-md:mx-auto sm:mt-6 sm:w-1/3'></div>
